// VS Code tasks — run via Terminal > Run Task, or use shortcuts:
//   Ctrl+Shift+B  → Build (default build task)
//   "Tasks: Run Test Task" → Run tests (default test task)
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./build/debug/warden-console",
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "ctest --preset debug",
      "dependsOn": "Build",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    // ── Utilities ──
    {
      "label": "Clean all build directories",
      "type": "shell",
      "command": "rm -rf build/",
      "problemMatcher": []
    }
  ]
}
