// VS Code tasks — run via Terminal > Run Task, or use shortcuts:
//   Ctrl+Shift+B  → Build (default build task)
//   "Tasks: Run Test Task" → Run tests (default test task)
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run",
      "type": "shell",
      // lsan.supp: Qt's own objects left at exit are not reported as leaks.
      "command": "LSAN_OPTIONS=suppressions=lsan.supp:print_suppressions=0 ./build/debug/warden-console",
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Run (simulated)",
      "type": "shell",
      // Two made-up devices, no broker needed.
      "command": "LSAN_OPTIONS=suppressions=lsan.supp:print_suppressions=0 ./build/debug/warden-console --simulate",
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "ctest --preset debug",
      "dependsOn": "Build",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    // ── Checks ──
    {
      // All the checks in one task.
      "label": "Workflow: Verify",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug --target format-check && cmake --workflow --preset tidy && cmake --build --preset debug && ctest --preset debug && cmake --workflow --preset release",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Workflow: Tidy",
      "type": "shell",
      "command": "cmake --workflow --preset tidy",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Workflow: Release build and test",
      "type": "shell",
      "command": "cmake --workflow --preset release",
      "problemMatcher": ["$gcc"]
    },
    // ── Utilities ──
    {
      "label": "Format all sources",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug --target format",
      "problemMatcher": []
    },
    {
      "label": "Clean all build directories",
      "type": "shell",
      "command": "rm -rf build/",
      "problemMatcher": []
    }
  ]
}
