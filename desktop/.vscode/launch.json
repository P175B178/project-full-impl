// Debug configuration — press F5 to build and debug.
// Requires the C/C++ extension (ms-vscode.cpptools).
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/warden-console",
      "args": [],
      "cwd": "${workspaceFolder}",
      // LeakSanitizer cannot run under a debugger; the Run task checks for leaks.
      "environment": [{ "name": "ASAN_OPTIONS", "value": "detect_leaks=0" }],
      "preLaunchTask": "Build",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
