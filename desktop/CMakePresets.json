{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang-Tidy",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy", "cleanFirst": true }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ],
  "packagePresets": [
    {
      "name": "release",
      "displayName": "Release (.deb)",
      "configurePreset": "release",
      "packageDirectory": "${sourceDir}/package"
    }
  ],
  "workflowPresets": [
    {
      "name": "tidy",
      "displayName": "Tidy — static analysis",
      "steps": [
        { "type": "configure", "name": "clang-tidy" },
        { "type": "build",     "name": "clang-tidy" }
      ]
    },
    {
      "name": "release",
      "displayName": "Release — build and test",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build",     "name": "release" },
        { "type": "test",      "name": "release" }
      ]
    },
    {
      "name": "package",
      "displayName": "Package — release build as .deb",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build",     "name": "release" },
        { "type": "package",   "name": "release" }
      ]
    }
  ]
}
